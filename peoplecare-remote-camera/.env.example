# =============================================================================
# PeopleCare Remote Camera - configuration reference
# =============================================================================
# This file documents EVERY variable of the project. It contains placeholders
# only: never put real credentials in the repository.
#
#  - Cloudflare Worker SECRETS  -> `npx wrangler secret put <NAME>` (production)
#                                   or cloudflare/worker/.dev.vars (local dev)
#  - Cloudflare Worker VARS     -> cloudflare/worker/wrangler.jsonc ("vars")
#  - Build variables            -> read by scripts/*.sh (copy this file to .env)
#
# The Cloudflare API token and account id live ONLY as Worker secrets: they are
# never compiled into the APK and never sent to the Control Room browser.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Worker secrets (wrangler secret put ...)
# -----------------------------------------------------------------------------
# Cloudflare account id (Dashboard -> Account home -> Account ID).
CLOUDFLARE_ACCOUNT_ID=PLACEHOLDER_CLOUDFLARE_ACCOUNT_ID
# API token with the "Stream: Edit" account permission (see docs/CLOUDFLARE_SETUP.md).
CLOUDFLARE_API_TOKEN=PLACEHOLDER_CLOUDFLARE_API_TOKEN
# Password of the Control Room (regia), minimum 12 characters.
CONTROL_ROOM_PASSWORD=PLACEHOLDER_CHANGE_ME_MIN_12_CHARS
# Optional: secret of the Cloudflare Notifications webhook for Stream Live
# events (header cf-webhook-auth). Leave empty to use API polling only.
STREAM_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# 2. Worker variables (wrangler.jsonc "vars"; defaults shown)
# -----------------------------------------------------------------------------
# Name shown in the Control Room.
APP_NAME="PeopleCare Remote Camera"
# Extra origins allowed to call the API / open the control WebSocket
# (comma separated). The Worker's own origin is always allowed.
# Example for local development of the Control Room: http://localhost:5173
ALLOWED_ORIGINS=
# Control Room session lifetime in hours (1-72).
SESSION_TTL_HOURS=12
# Lifetime of a pairing code shown by the phone, in minutes (2-60).
PAIRING_TTL_MINUTES=10
# Customer subdomain code of Stream (customer-<CODE>.cloudflarestream.com),
# used for the preview player. Optional: the Worker discovers it from the
# first recording when empty.
CLOUDFLARE_STREAM_CUSTOMER_CODE=
# Live input recording: automatic | off. Must be "automatic" for the
# Cloudflare preview player/HLS in the Control Room.
STREAM_RECORDING_MODE=automatic
# Delete recordings after N days (>= 30, 0 = keep).
STREAM_DELETE_RECORDING_AFTER_DAYS=30
# Low-Latency HLS for new live inputs (Cloudflare beta): true | false.
STREAM_PREFER_LOW_LATENCY=false
# Origins allowed to embed the Stream player (comma separated, empty = any).
STREAM_ALLOWED_ORIGINS=
# Defaults sent to the phone with the streaming configuration.
DEFAULT_RESOLUTION=1080p
DEFAULT_FPS=30
DEFAULT_VIDEO_BITRATE_KBPS=5000
DEFAULT_AUDIO_BITRATE_KBPS=128
# SRT latency used by the phone (ms, 80-8000).
SRT_LATENCY_MS=500
# What happens to the live input when a camera is revoked:
# rotate (new keys, default) | disable | delete | none
REVOKE_ACTION=rotate
# Server watchdog: asks the phone to reconnect when Cloudflare reports the
# input as disconnected while the phone says it is LIVE. true | false
CF_WATCHDOG=true
# Polling interval of the live input status while a camera is active (10-300 s).
CF_POLL_INTERVAL_SECONDS=20
# Location hint of the Durable Object (wnam, enam, sam, weur, eeur, apac, oc, afr, me).
DO_LOCATION_HINT=weur

# -----------------------------------------------------------------------------
# 3. Build variables (scripts/build_android.sh, scripts/deploy_cloudflare.sh)
# -----------------------------------------------------------------------------
# Default control plane URL baked into the APK (can be changed in the app).
# Example: https://peoplecare-remote-camera.<your-subdomain>.workers.dev
CONTROL_PLANE_URL=
# Debug only: allow http:// control planes (local `wrangler dev`). Never in production.
ALLOW_INSECURE_CONTROL_PLANE=false
# Optional local Maven repository with RootEncoder built from source
# (scripts/build_rootencoder_from_source.sh) when jitpack.io is unreachable.
ROOTENCODER_MAVEN_REPO=
