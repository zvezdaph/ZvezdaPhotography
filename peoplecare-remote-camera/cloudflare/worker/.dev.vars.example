# Copy to .dev.vars for `wrangler dev` (never commit .dev.vars).
CONTROL_ROOM_PASSWORD=PLACEHOLDER_CHANGE_ME_MIN_12_CHARS
CLOUDFLARE_ACCOUNT_ID=PLACEHOLDER_CLOUDFLARE_ACCOUNT_ID
CLOUDFLARE_API_TOKEN=PLACEHOLDER_CLOUDFLARE_API_TOKEN
# STREAM_WEBHOOK_SECRET=PLACEHOLDER_WEBHOOK_SECRET
# Allow the Vite dev server of the control room:
ALLOWED_ORIGINS=http://localhost:5173
